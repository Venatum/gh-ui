#!/usr/bin/env bash
# A stand-in for `gh`, for the README recording only (see record.sh): canned
# data from fixtures/, no network, no real account. It answers the handful of
# commands gh-ui runs and honors the filters that change what shows on
# screen; the others are ignored.
set -euo pipefail

fixtures="$(cd "$(dirname "$0")" && pwd)/fixtures"
me="Venatum"

# `@me` is gh's word for the logged-in user.
who() { [[ "$1" == "@me" ]] && echo "$me" || echo "$1"; }

# `gh ui`: what the real gh does for an installed extension, run `gh-ui`.
if [[ "${1:-}" == "ui" ]]; then
  shift
  exec gh-ui "$@"
fi

# Relative dates: "@ago:2" is two days ago, "@min:90" an hour and a half
# ago, so today stays today whenever the GIF is recorded.
ago_dates='walk(if type == "string" and startswith("@ago:")
    then (now - (.[5:] | tonumber) * 86400 | floor | todate)
  elif type == "string" and startswith("@min:")
    then (now - (.[5:] | tonumber) * 60 | floor | todate)
  else . end)'

case "${1:-} ${2:-}" in
  "auth status") echo "$me"; exit 0 ;;
  "org list") echo "acme"; exit 0 ;;
  "pr list") file="$fixtures/prs/$(basename "$PWD").json" ;;
  # `pr view <n>`: the PR's row of `pr list`, so the two always agree,
  # completed by what only the detail view asks for (body, files,
  # comments…) from pr-view/<repo>-<n>.json when there is one.
  "pr view")
    repo="$(basename "$PWD")"
    extra="$(cat "$fixtures/pr-view/$repo-$3.json" 2>/dev/null || echo '{}')"
    jq -n --argjson n "$3" --argjson extra "$extra" \
      --slurpfile list "$fixtures/prs/$repo.json" '
      (first($list[0][] | select(.number == $n))
        // error("no pull requests found for #\($n)"))
      | {state: "OPEN", baseRefName: "main", body: "", files: [],
         comments: [], latestReviews: [], reviewRequests: []} + . + $extra
      | .changedFiles //= (.files | length)
      | .headRefOid //= "4f1c2e9" | .headRefOid as $head
      | .reviews //= (.latestReviews | map(. + {commit: {oid: $head}}))
      | '"$ago_dates"
    exit ;;
  "run list") file="$fixtures/runs/$(basename "$PWD").json" ;;
  "issue list") file="$fixtures/issues/$(basename "$PWD").json" ;;
  "release list") file="$fixtures/releases/$(basename "$PWD").json" ;;
  # `release view [-- tag]`: one release and the page GitHub would give.
  # No tag asks for GitHub's "Latest"; a repo without one, as for real,
  # answers "release not found".
  "release view")
    tag=""
    while (($#)); do [[ "$1" == "--" ]] && { tag="${2:-}"; break; }; shift; done
    repo="$(basename "$PWD")"
    release="$(jq --arg tag "$tag" --arg repo "$repo" "$ago_dates"' |
      map(select(if $tag == "" then .isLatest else .tagName == $tag end)) | first
      | select(. != null) | del(.isLatest)
      | .url = "https://github.com/acme/\($repo)/releases/tag/\(.tagName)"' \
      "$fixtures/releases/$repo.json" 2>/dev/null)"
    [[ -n "$release" ]] || { echo "release not found" >&2; exit 1; }
    echo "$release"; exit 0 ;;
  "repo list") file="$fixtures/repos/$3.json"; shift ;;
  # `repo clone owner/name dest`: an empty repo pointing at it, after a
  # pause so the batch reads queued → cloning → cloned.
  "repo clone")
    sleep 1
    git init --quiet "$4"
    git -C "$4" remote add origin "git@github.com:$3.git"
    exit 0 ;;
  *) echo "demo gh: \`$*\` is not part of the demo" >&2; exit 1 ;;
esac
shift 2

# Relative dates first (see `ago_dates`).
jq_filter="$ago_dates | .[]"
while (($#)); do
  case "$1" in
    --author) jq_filter+=" | select(.author.login == \"$(who "$2")\")"; shift ;;
    --assignee) jq_filter+=" | select(any(.assignees[]; .login == \"$(who "$2")\"))"; shift ;;
    --label) jq_filter+=" | select(any(.labels[]; .name == \"$2\"))"; shift ;;
    --no-archived) jq_filter+=" | select(.isArchived | not)" ;;
    --source) jq_filter+=" | select(.isFork | not)" ;;
    --search)
      for term in $2; do
        case "$term" in
          draft:false) jq_filter+=" | select(.isDraft | not)" ;;
          no:assignee) jq_filter+=" | select(.assignees == [])" ;;
          updated:\>=*) jq_filter+=" | select(.updatedAt >= \"${term#updated:>=}\")" ;;
          -author:*) jq_filter+=" | select(.author.login != \"$(who "${term#-author:}")\")" ;;
        esac
      done
      shift ;;
    --state | --limit | --json) shift ;; # the fixtures are already that
  esac
  shift
done

[[ -f "$file" ]] || { echo "[]"; exit 0; }
jq "[$jq_filter]" "$file"
