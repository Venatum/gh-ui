# Generated from packaging/homebrew/gh-ui.rb.tmpl in Venatum/gh-ui by
# .github/workflows/release.yml, which fills in the version and the checksums
# and pushes the result to the tap as Formula/gh-ui.rb
#
# Do not edit this file by hand: edit the template instead.
class GhUi < Formula
  desc "Terminal UI to explore GitHub pull requests across every repo in a folder"
  homepage "https://github.com/Venatum/gh-ui"
  version "@VERSION@"
  license any_of: ["MIT", "Apache-2.0"]

  # Default download: the source tarball. Only platforms without a prebuilt
  # binary below ever land here.
  url "https://github.com/Venatum/gh-ui/archive/refs/tags/v@VERSION@.tar.gz"
  sha256 "@SHA_SOURCE@"

  # A url inside one of these blocks wins over the one above, so macOS and
  # Linux on arm64/x86_64 install a ready-made binary: no compilation.
  on_macos do
    on_arm do
      url "https://github.com/Venatum/gh-ui/releases/download/v@VERSION@/gh-ui_@VERSION@_darwin-arm64.tar.gz"
      sha256 "@SHA_DARWIN_ARM64@"
    end
    on_intel do
      url "https://github.com/Venatum/gh-ui/releases/download/v@VERSION@/gh-ui_@VERSION@_darwin-amd64.tar.gz"
      sha256 "@SHA_DARWIN_AMD64@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/Venatum/gh-ui/releases/download/v@VERSION@/gh-ui_@VERSION@_linux-arm64.tar.gz"
      sha256 "@SHA_LINUX_ARM64@"
    end
    on_intel do
      url "https://github.com/Venatum/gh-ui/releases/download/v@VERSION@/gh-ui_@VERSION@_linux-amd64.tar.gz"
      sha256 "@SHA_LINUX_AMD64@"
    end
  end

  # gh-ui shells out to `gh` for every API call.
  depends_on "gh"

  # Only the source fallback needs a toolchain; the binaries cover arm64 and
  # x86_64 on both systems.
  depends_on "rust" => :build unless Hardware::CPU.arm? || Hardware::CPU.intel?

  def install
    # The source tarball carries a Cargo.toml, the binary archives do not.
    if File.exist?("Cargo.toml")
      system "cargo", "install", *std_cargo_args
    else
      bin.install "gh-ui"
    end
  end

  test do
    assert_match "gh-ui #{version}", shell_output("#{bin}/gh-ui --version")
  end
end
